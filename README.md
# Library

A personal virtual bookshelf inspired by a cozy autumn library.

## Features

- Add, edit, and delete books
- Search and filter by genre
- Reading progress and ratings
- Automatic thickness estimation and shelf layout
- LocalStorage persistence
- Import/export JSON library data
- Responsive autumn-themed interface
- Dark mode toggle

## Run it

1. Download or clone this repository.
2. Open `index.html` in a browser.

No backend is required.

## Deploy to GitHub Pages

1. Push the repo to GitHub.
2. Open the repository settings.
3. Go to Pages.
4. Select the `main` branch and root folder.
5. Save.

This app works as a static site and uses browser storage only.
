const STORAGE_KEY = 'libraryBooks';
const THEME_KEY = 'libraryTheme';
const PAGE_THICKNESS_MM = 0.055;
const MIN_THICKNESS = 8;
const MAX_THICKNESS = 70;

const state = {
  books: [],
  searchTerm: '',
  genreFilter: 'all',
  currentPage: 0,
  activeBookId: null,
  editingId: null,
  deletingId: null,
  theme: 'light',
  pendingCover: '',
  pendingSpine: ''
};

const elements = {
  bookshelfContainer: document.getElementById('bookshelfContainer'),
  searchInput: document.getElementById('searchInput'),
  genreFilter: document.getElementById('genreFilter'),
  addBookBtn: document.getElementById('addBookBtn'),
  emptyState: document.getElementById('emptyState'),
  emptyAddBtn: document.getElementById('emptyAddBtn'),
  themeToggle: document.getElementById('themeToggle'),
  menuToggle: document.getElementById('menuToggle'),
  menuPanel: document.getElementById('menuPanel'),
  exportBtn: document.getElementById('exportBtn'),
  importBtn: document.getElementById('importBtn'),
  importInput: document.getElementById('importInput'),
  clearSamplesBtn: document.getElementById('clearSamplesBtn'),
  prevPageBtn: document.getElementById('prevPageBtn'),
  nextPageBtn: document.getElementById('nextPageBtn'),
  pageCounter: document.getElementById('pageCounter'),
  statusText: document.getElementById('statusText'),
  bookModal: document.getElementById('bookModal'),
  detailCover: document.getElementById('detailCover'),
  detailGenre: document.getElementById('detailGenre'),
  bookDetailTitle: document.getElementById('bookDetailTitle'),
  detailAuthor: document.getElementById('detailAuthor'),
  detailDescription: document.getElementById('detailDescription'),
  detailProgressLabel: document.getElementById('detailProgressLabel'),
  detailProgressBar: document.getElementById('detailProgressBar'),
  detailRating: document.getElementById('detailRating'),
  detailDimensions: document.getElementById('detailDimensions'),
  editBookBtn: document.getElementById('editBookBtn'),
  deleteBookBtn: document.getElementById('deleteBookBtn'),
  bookFormModal: document.getElementById('bookFormModal'),
  formTitle: document.getElementById('formTitle'),
  bookForm: document.getElementById('bookForm'),
  formError: document.getElementById('formError'),
  deleteModal: document.getElementById('deleteModal'),
  confirmDeleteBtn: document.getElementById('confirmDeleteBtn'),
  toastContainer: document.getElementById('toastContainer'),
  leafLayer: document.getElementById('leafLayer')
};

function init() {
  bindEvents();
  state.theme = readTheme();
  applyTheme(state.theme);
  loadFromLocalStorage();
  render();
  createAutumnLeaves();
}

function bindEvents() {
  elements.searchInput.addEventListener('input', (event) => {
    state.searchTerm = event.target.value.toLowerCase().trim();
    state.currentPage = 0;
    render();
  });

  elements.genreFilter.addEventListener('change', (event) => {
    state.genreFilter = event.target.value;
    state.currentPage = 0;
    render();
  });

  elements.addBookBtn.addEventListener('click', openAddBookModal);
  elements.emptyAddBtn.addEventListener('click', openAddBookModal);
  elements.themeToggle.addEventListener('click', () => {
    const next = state.theme === 'light' ? 'dark' : 'light';
    applyTheme(next);
    localStorage.setItem(THEME_KEY, next);
  });

  elements.menuToggle.addEventListener('click', () => {
    const hidden = elements.menuPanel.classList.toggle('hidden');
    elements.menuToggle.setAttribute('aria-expanded', String(!hidden));
  });

  elements.exportBtn.addEventListener('click', exportLibrary);
  elements.importBtn.addEventListener('click', () => elements.importInput.click());
  elements.clearSamplesBtn.addEventListener('click', () => {
    state.books = [];
    saveToLocalStorage();
    render();
    showToast('Sample books cleared.');
  });
  elements.importInput.addEventListener('change', handleImport);

  elements.prevPageBtn.addEventListener('click', () => {
    if (state.currentPage > 0) {
      state.currentPage -= 1;
      render();
    }
  });

  elements.nextPageBtn.addEventListener('click', () => {
    const pages = getVisiblePages();
    if (state.currentPage < pages.length - 1) {
      state.currentPage += 1;
      render();
    }
  });

  elements.bookForm.addEventListener('submit', (event) => {
    event.preventDefault();
    const bookData = collectFormData();
    if (!bookData) return;

    if (state.editingId) {
      const index = state.books.findIndex((book) => book.id === state.editingId);
      if (index >= 0) {
        state.books[index] = { ...state.books[index], ...bookData };
      }
      showToast('Book updated.');
    } else {
      state.books.push(bookData);
      showToast('Book added to your library.');
    }

    saveToLocalStorage();
    state.currentPage = 0;
    closeFormModal();
    render();
  });

  elements.deleteBookBtn.addEventListener('click', () => {
    state.deletingId = state.activeBookId;
    elements.deleteModal.classList.remove('hidden');
  });

  elements.confirmDeleteBtn.addEventListener('click', () => {
    if (!state.deletingId) return;
    state.books = state.books.filter((book) => book.id !== state.deletingId);
    state.deletingId = null;
    closeDeleteModal();
    saveToLocalStorage();
    state.currentPage = 0;
    render();
    showToast('Book removed.');
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (target instanceof HTMLElement && target.matches('[data-close]')) {
      const name = target.dataset.close;
      if (name === 'bookModal') closeBookModal();
      if (name === 'bookFormModal') closeFormModal();
      if (name === 'deleteModal') closeDeleteModal();
    }

    if (!event.target.closest('#menuToggle') && !event.target.closest('#menuPanel')) {
      elements.menuPanel.classList.add('hidden');
      elements.menuToggle.setAttribute('aria-expanded', 'false');
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeBookModal();
      closeFormModal();
      closeDeleteModal();
      elements.menuPanel.classList.add('hidden');
      elements.menuToggle.setAttribute('aria-expanded', 'false');
    }
  });

  document.getElementById('coverInput').addEventListener('change', async (event) => {
    const file = event.target.files?.[0];
    if (!file) return;
    try {
      state.pendingCover = await compressImage(file);
    } catch (error) {
      showToast(error.message || 'Invalid image.');
    }
  });

  document.getElementById('spineInput').addEventListener('change', async (event) => {
    const file = event.target.files?.[0];
    if (!file) return;
    try {
      state.pendingSpine = await compressImage(file);
    } catch (error) {
      showToast(error.message || 'Invalid image.');
    }
  });

  elements.editBookBtn.addEventListener('click', () => {
    const book = state.books.find((item) => item.id === state.activeBookId);
    if (!book) return;
    openEditBookModal(book);
  });
}

function render() {
  updateGenreSelect();

  const filtered = filterBooks();
  const pages = getVisiblePages(filtered);
  const totalLibraryBooks = state.books.length;

  if (totalLibraryBooks === 0) {
    elements.emptyState.classList.remove('hidden');
    elements.bookshelfContainer.innerHTML = '';
    elements.statusText.textContent = '0 books found';
    elements.pageCounter.textContent = 'Bookshelf 1 of 1';
    return;
  }

  elements.emptyState.classList.add('hidden');

  if (!filtered.length) {
    elements.bookshelfContainer.innerHTML = '<div class="no-results">No books found.</div>';
    elements.statusText.textContent = 'No books found.';
    elements.pageCounter.textContent = 'Bookshelf 1 of 1';
    elements.prevPageBtn.disabled = true;
    elements.nextPageBtn.disabled = true;
    return;
  }

  if (state.currentPage > pages.length - 1) state.currentPage = pages.length - 1;
  const page = pages[state.currentPage] || pages[0];

  elements.bookshelfContainer.innerHTML = '';
  const pageWrapper = document.createElement('div');
  pageWrapper.className = 'bookshelf-page';

  page.shelves.forEach((shelf) => {
    const shelfEl = document.createElement('div');
    shelfEl.className = 'bookshelf-shelf';
    shelf.books.forEach((book) => {
      shelfEl.appendChild(renderBookSpine(book));
    });
    pageWrapper.appendChild(shelfEl);
  });

  elements.bookshelfContainer.appendChild(pageWrapper);

  elements.statusText.textContent = `${filtered.length} ${filtered.length === 1 ? 'book found' : 'books found'}`;
  elements.pageCounter.textContent = `Bookshelf ${state.currentPage + 1} of ${pages.length}`;
  elements.prevPageBtn.disabled = pages.length <= 1 || state.currentPage === 0;
  elements.nextPageBtn.disabled = pages.length <= 1 || state.currentPage >= pages.length - 1;
}

function updateGenreSelect() {
  const genres = ['all', ...new Set(state.books.map((book) => book.genre).filter(Boolean))];
  const currentValue = state.genreFilter;

  elements.genreFilter.innerHTML = '<option value="all">All Genres</option>' +
    genres.filter((genre) => genre !== 'all').map((genre) => `<option value="${escapeHtml(genre)}">${escapeHtml(genre)}</option>`).join('');

  if (genres.includes(currentValue)) {
    elements.genreFilter.value = currentValue;
  } else {
    elements.genreFilter.value = 'all';
    state.genreFilter = 'all';
  }
}

function filterBooks() {
  return state.books.filter((book) => {
    const inSearch = `${book.title} ${book.author}`.toLowerCase().includes(state.searchTerm);
    const inGenre = state.genreFilter === 'all' || book.genre === state.genreFilter;
    return inSearch && inGenre;
  });
}

function renderBookSpine(book) {
  const button = document.createElement('button');
  button.type = 'button';
  button.className = 'book-spine';
  button.dataset.id = book.id;
  button.setAttribute('aria-label', `${book.title} by ${book.author}`);

  const thickness = calculateBookThickness(book);
  const visualWidth = calculateVisualWidth(book);
  const height = normalizeHeight(book.height);
  const left = computeSlot(book, thickness, visualWidth);
  const tilt = randomBetween(-2.2, 2.2);
  const color = sanitizeColor(book.color || '#8d5a3a');

  button.style.setProperty('--width', `${visualWidth}px`);
  button.style.setProperty('--height', `${height}px`);
  button.style.setProperty('--left', `${left}px`);
  button.style.setProperty('--tilt', `${tilt}deg`);
  button.style.setProperty('--book-color', color);

  if (book.spineImage) {
    button.style.background = `url('${book.spineImage}') center/cover no-repeat, linear-gradient(90deg, rgba(0,0,0,0.18), rgba(255,255,255,0.04))`;
  } else {
    const darker = shadeColor(color, -20);
    const lighter = shadeColor(color, 20);
    button.style.background = `linear-gradient(90deg, ${darker}, ${color} 26%, ${lighter} 100%)`;
  }

  const label = document.createElement('span');
  label.className = 'book-spine-title';
  label.textContent = book.title;
  button.appendChild(label);

  const tooltip = document.createElement('span');
  tooltip.className = 'tooltip';
  tooltip.innerHTML = `<strong>${escapeHtml(book.title)}</strong><br>${escapeHtml(book.author)}`;
  button.appendChild(tooltip);

  button.addEventListener('click', () => openBookDetails(book.id));
  return button;
}

function getVisiblePages(books = filterBooks()) {
  const pages = [];
  const compWidth = Math.max(260, Math.min(920, elements.bookshelfContainer.clientWidth - 80));

  let currentPage = { shelves: Array.from({ length: 3 }, () => ({ books: [], width: 0 })) };
  let shelfIndex = 0;

  books.forEach((book) => {
    const width = calculateVisualWidth(book) + 16;
    let placed = false;

    while (shelfIndex < 3) {
      const shelf = currentPage.shelves[shelfIndex];
      if (shelf.width + width <= compWidth) {
        shelf.books.push(book);
        shelf.width += width;
        placed = true;
        break;
      }
      shelfIndex += 1;
    }

    if (!placed) {
      pages.push(currentPage);
      currentPage = { shelves: Array.from({ length: 3 }, () => ({ books: [], width: 0 })) };
      shelfIndex = 0;
      const firstShelf = currentPage.shelves[0];
      firstShelf.books.push(book);
      firstShelf.width += width;
    }
  });

  if (currentPage.shelves.some((shelf) => shelf.books.length)) {
    pages.push(currentPage);
  }

  return pages.length ? pages : [{ shelves: Array.from({ length: 3 }, () => ({ books: [], width: 0 })) }];
}

function openBookDetails(id) {
  const book = state.books.find((item) => item.id === id);
  if (!book) return;

  state.activeBookId = id;
  elements.detailGenre.textContent = book.genre || 'Other';
  elements.bookDetailTitle.textContent = book.title;
  elements.detailAuthor.textContent = `by ${book.author}`;
  elements.detailDescription.textContent = book.description || 'No description yet.';

  const progress = clamp(Number(book.progress) || 0, 0, 100);
  elements.detailProgressLabel.textContent = `${progress}%`;
  elements.detailProgressBar.style.width = `${progress}%`;

  const rating = clamp(Number(book.rating) || 0, 0, 10);
  elements.detailRating.textContent = `${rating.toFixed(1)} / 10`;

  const coverEl = document.createElement('div');
  coverEl.className = 'detail-cover-art';
  const color = sanitizeColor(book.color || '#8d5a3a');

  if (book.coverImage) {
    coverEl.style.backgroundImage = `linear-gradient(180deg, rgba(19,9,8,0.18), rgba(19,9,8,0.28)), url('${book.coverImage}')`;
    coverEl.textContent = '';
  } else {
    const initials = (book.title || 'B').split(' ').slice(0, 2).map((part) => part[0]).join('').toUpperCase();
    coverEl.style.background = `linear-gradient(160deg, ${shadeColor(color, 18)}, ${shadeColor(color, -28)} 60%, ${shadeColor(color, -48)})`;
    coverEl.textContent = initials || 'B';
  }
  elements.detailCover.innerHTML = '';
  elements.detailCover.appendChild(coverEl);

  const dims = [
    ['Pages', String(book.pages || 0)],
    ['Height', `${Math.round(Number(book.height) || 0)} mm`],
    ['Width', `${Math.round(Number(book.width) || 0)} mm`],
    ['Thickness', `${formatThickness(book)} mm`]
  ];

  elements.detailDimensions.innerHTML = dims.map(([label, value]) => `<li><span>${label}</span><strong>${value}</strong></li>`).join('');
  elements.bookModal.classList.remove('hidden');
}

function closeBookModal() {
  elements.bookModal.classList.add('hidden');
  state.activeBookId = null;
}

function openAddBookModal() {
  state.editingId = null;
  state.pendingCover = '';
  state.pendingSpine = '';
  elements.formTitle.textContent = 'Add a new book';
  elements.bookForm.reset();
  document.getElementById('titleInput').focus();
  document.getElementById('colorInput').value = '#8d5a3a';
  document.getElementById('progressInput').value = '0';
  document.getElementById('ratingInput').value = '0';
  elements.formError.textContent = '';
  elements.bookFormModal.classList.remove('hidden');
}

function openEditBookModal(book) {
  state.editingId = book.id;
  state.pendingCover = book.coverImage || '';
  state.pendingSpine = book.spineImage || '';
  elements.formTitle.textContent = 'Edit book';
  elements.formError.textContent = '';

  document.getElementById('titleInput').value = book.title || '';
  document.getElementById('authorInput').value = book.author || '';
  document.getElementById('genreInput').value = book.genre || '';
  document.getElementById('descriptionInput').value = book.description || '';
  document.getElementById('pagesInput').value = book.pages || 0;
  document.getElementById('heightInput').value = book.height || 0;
  document.getElementById('widthInput').value = book.width || 0;
  document.getElementById('thicknessInput').value = book.thickness || '';
  document.getElementById('progressInput').value = book.progress || 0;
  document.getElementById('ratingInput').value = book.rating || 0;
  document.getElementById('colorInput').value = sanitizeColor(book.color || '#8d5a3a');
