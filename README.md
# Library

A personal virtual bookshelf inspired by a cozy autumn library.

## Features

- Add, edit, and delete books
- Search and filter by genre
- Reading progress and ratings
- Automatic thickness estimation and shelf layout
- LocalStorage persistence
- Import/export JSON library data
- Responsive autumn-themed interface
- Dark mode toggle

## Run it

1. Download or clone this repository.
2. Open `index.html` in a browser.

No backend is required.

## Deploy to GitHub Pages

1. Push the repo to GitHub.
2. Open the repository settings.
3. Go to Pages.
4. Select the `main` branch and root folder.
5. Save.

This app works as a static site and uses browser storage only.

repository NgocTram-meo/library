}

function closeFormModal() {
  elements.bookFormModal.classList.add('hidden');
  state.editingId = null;
  state.pendingCover = '';
  state.pendingSpine = '';
  elements.bookForm.reset();
  elements.formError.textContent = '';
}

function closeDeleteModal() {
  state.deletingId = null;
  elements.deleteModal.classList.add('hidden');
}

function collectFormData() {
  const title = document.getElementById('titleInput').value.trim();
  const author = document.getElementById('authorInput').value.trim();
  const genre = document.getElementById('genreInput').value.trim();
  const description = document.getElementById('descriptionInput').value.trim();
  const pages = Number(document.getElementById('pagesInput').value);
  const height = Number(document.getElementById('heightInput').value);
  const width = Number(document.getElementById('widthInput').value);
  const thickness = Number(document.getElementById('thicknessInput').value || 0);
  const unit = document.getElementById('unitInput').value;
  const progress = Number(document.getElementById('progressInput').value);
  const rating = Number(document.getElementById('ratingInput').value);
  const color = sanitizeColor(document.getElementById('colorInput').value);

  if (!title) return invalidForm('Title is required.');
  if (!author) return invalidForm('Author is required.');
  if (!genre) return invalidForm('Genre is required.');
  if (!Number.isFinite(pages) || pages <= 0) return invalidForm('Pages must be a positive number.');
  if (!Number.isFinite(height) || height <= 0) return invalidForm('Height must be a positive number.');
  if (!Number.isFinite(width) || width <= 0) return invalidForm('Width must be a positive number.');
  if (!Number.isFinite(progress) || progress < 0 || progress > 100) return invalidForm('Reading progress must be between 0 and 100.');
  if (!Number.isFinite(rating) || rating < 0 || rating > 10) return invalidForm('Rating must be between 0 and 10.');

  const finalHeight = unit === 'cm' ? height * 10 : height;
  const finalWidth = unit === 'cm' ? width * 10 : width;
  const finalThickness = unit === 'cm' ? thickness * 10 : thickness;
  const calcThickness = calculateEstimatedThickness(pages);

  return {
    id: state.editingId || createId(),
    title,
    author,
    genre,
    description,
    pages,
    height: finalHeight,
    width: finalWidth,
    thickness: finalThickness > 0 ? finalThickness : calcThickness,
    estimatedThickness: calcThickness,
    progress: Math.round(progress),
    rating: Number(rating.toFixed(1)),
    color,
    coverImage: state.pendingCover || (state.editingId ? findBook(state.editingId)?.coverImage || '' : ''),
    spineImage: state.pendingSpine || (state.editingId ? findBook(state.editingId)?.spineImage || '' : ''),
    shelfIndex: 0,
    createdAt: state.editingId ? findBook(state.editingId)?.createdAt || new Date().toISOString() : new Date().toISOString()
  };
}

function invalidForm(message) {
  elements.formError.textContent = message;
  return null;
}

function exportLibrary() {
  const exportData = JSON.stringify(state.books, null, 2);
  const blob = new Blob([exportData], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'library-export.json';
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
  showToast('Library exported.');
}

async function handleImport(event) {
  const file = event.target.files?.[0];
  if (!file) return;

  try {
    const text = await file.text();
    const json = JSON.parse(text);
    if (!Array.isArray(json)) throw new Error('Invalid import format.');

    const validBooks = json.map(normalizeBook).filter(Boolean);
    if (!validBooks.length) throw new Error('No valid books found.');

    state.books = validBooks;
    saveToLocalStorage();
    state.currentPage = 0;
    render();
    showToast('Library imported.');
  } catch (error) {
    showToast(error.message || 'Invalid JSON import.');
  } finally {
    event.target.value = '';
  }
}

function normalizeBook(raw) {
  if (!raw || typeof raw !== 'object') return null;
  const title = String(raw.title || '').trim();
  const author = String(raw.author || '').trim();
  const genre = String(raw.genre || '').trim();
  if (!title || !author || !genre) return null;

  const pages = Number(raw.pages) > 0 ? Number(raw.pages) : 200;
  const height = Number(raw.height) > 0 ? Number(raw.height) : 210;
  const width = Number(raw.width) > 0 ? Number(raw.width) : 120;
  const thickness = Number(raw.thickness) > 0 ? Number(raw.thickness) : calculateEstimatedThickness(pages);

  return {
    id: String(raw.id || createId()),
    title,
    author,
    genre,
    description: String(raw.description || ''),
    coverImage: String(raw.coverImage || ''),
    spineImage: String(raw.spineImage || ''),
    color: sanitizeColor(raw.color || '#8d5a3a'),
    pages,
    height,
    width,
    thickness,
    estimatedThickness: Number(raw.estimatedThickness) > 0 ? Number(raw.estimatedThickness) : calculateEstimatedThickness(pages),
    progress: clamp(Number(raw.progress) || 0, 0, 100),
    rating: clamp(Number(raw.rating) || 0, 0, 10),
    shelfIndex: 0,
    createdAt: String(raw.createdAt || new Date().toISOString())
  };
}

function loadFromLocalStorage() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) {
      state.books = createSampleBooks();
      saveToLocalStorage();
      return;
    }
    const parsed = JSON.parse(raw);
    if (!Array.isArray(parsed)) throw new Error('Bad data');
    state.books = parsed.map(normalizeBook).filter(Boolean);
    if (!state.books.length) {
      state.books = createSampleBooks();
      saveToLocalStorage();
    }
  } catch (error) {
    state.books = createSampleBooks();
    saveToLocalStorage();
    showToast('Stored library was reset because it was corrupted.');
  }
}

function saveToLocalStorage() {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state.books));
  } catch (error) {
    showToast('Could not save the library locally.');
  }
}

