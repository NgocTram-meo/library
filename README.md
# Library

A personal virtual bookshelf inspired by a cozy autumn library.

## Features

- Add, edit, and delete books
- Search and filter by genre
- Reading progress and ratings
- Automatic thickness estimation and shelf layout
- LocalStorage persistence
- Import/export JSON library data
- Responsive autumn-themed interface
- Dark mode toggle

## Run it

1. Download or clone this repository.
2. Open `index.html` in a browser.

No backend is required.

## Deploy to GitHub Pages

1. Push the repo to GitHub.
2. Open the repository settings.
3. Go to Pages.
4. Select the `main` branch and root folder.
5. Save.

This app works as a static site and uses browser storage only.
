async function compressImage(file) {
  if (!file || !file.type.startsWith('image/')) {
    throw new Error('Invalid file. Please choose an image.');
  }

  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = (event) => {
      const img = new Image();
      img.onload = () => {
        const maxWidth = 1000;
        const ratio = Math.min(1, maxWidth / img.width);
        const canvas = document.createElement('canvas');
        canvas.width = Math.max(1, Math.round(img.width * ratio));
        canvas.height = Math.max(1, Math.round(img.height * ratio));

        const ctx = canvas.getContext('2d');
        if (!ctx) {
          reject(new Error('This browser cannot process images.'));
          return;
        }

        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        const mimeType = file.type === 'image/png' ? 'image/webp' : 'image/jpeg';
        canvas.toBlob((blob) => {
          if (!blob) {
            reject(new Error('Unable to compress image.'));
            return;
          }
          const fr = new FileReader();
          fr.onload = (e) => resolve(e.target.result);
          fr.onerror = () => reject(new Error('Image upload failed.'));
          fr.readAsDataURL(blob);
        }, mimeType, 0.8);
      };
      img.onerror = () => reject(new Error('Invalid image file.'));
      img.src = event.target.result;
    };
    reader.onerror = () => reject(new Error('Unable to read image.'));
    reader.readAsDataURL(file);
  });
}

function createAutumnLeaves() {
  const leafCount = 14;
  elements.leafLayer.innerHTML = '';

  for (let i = 0; i < leafCount; i += 1) {
    const leaf = document.createElement('span');
    leaf.className = 'leaf';
    const size = randomBetween(12, 24);
    const palette = ['var(--leaf-amber)', 'var(--leaf-rust)', 'var(--leaf-gold)', 'var(--leaf-brown)'];
    leaf.style.setProperty('--size', `${size}px`);
    leaf.style.setProperty('--leaf-color', palette[Math.floor(Math.random() * palette.length)]);
    leaf.style.setProperty('--dur', `${randomBetween(12, 18)}s`);
    leaf.style.setProperty('--delay', `${randomBetween(-10, 0)}s`);
    leaf.style.setProperty('--left', `${randomBetween(2, 95)}vw`);
    leaf.style.setProperty('--rot', `${randomBetween(-90, 90)}deg`);
    elements.leafLayer.appendChild(leaf);
  }
}

function showToast(message) {
  const toast = document.createElement('div');
  toast.className = 'toast';
  toast.textContent = message;
  elements.toastContainer.appendChild(toast);
  setTimeout(() => toast.remove(), 2200);
}

function calculateEstimatedThickness(pages) {
  const est = Number(pages) * PAGE_THICKNESS_MM;
  return clamp(est, MIN_THICKNESS, MAX_THICKNESS);
}

function calculateBookThickness(book) {
  if (Number.isFinite(Number(book.thickness)) && Number(book.thickness) > 0) {
    return clamp(Number(book.thickness), MIN_THICKNESS, MAX_THICKNESS);
  }
  return clamp(Number(book.estimatedThickness) || calculateEstimatedThickness(book.pages || 250), MIN_THICKNESS, MAX_THICKNESS);
}

function calculateVisualWidth(book) {
  const thickness = calculateBookThickness(book);
  return clamp(thickness * 1.55 + 18, 24, 86);
}

function normalizeHeight(heightMM) {
  const value = Number(heightMM) || 210;
  return clamp(value * 0.62, 100, 210);
}

function computeSlot(book, thickness, visualWidth) {
  const base = Number(book.shelfIndex) || 0;
  const offset = base * 42 + (book.pages % 18) * 3;
  return clamp(offset + 12, 12, 760);
}

function clamp(value, min, max) {
  return Math.min(Math.max(value, min), max);
}

function randomBetween(min, max) {
  return Math.random() * (max - min) + min;
}

function sanitizeColor(value) {
  if (!value) return '#8d5a3a';
  const hex = String(value).trim();
  return /^#[0-9a-fA-F]{3,6}$/.test(hex) ? hex : '#8d5a3a';
}

function shadeColor(hex, percent) {
  let color = sanitizeColor(hex).replace('#', '');
  if (color.length === 3) color = color.split('').map((c) => c + c).join('');
  const num = Number.parseInt(color, 16);
  const amount = Math.round((percent / 100) * 255);
  const r = clamp(((num >> 16) & 255) + amount, 0, 255);
  const g = clamp(((num >> 8) & 255) + amount, 0, 255);
  const b = clamp((num & 255) + amount, 0, 255);
  return `rgb(${r}, ${g}, ${b})`;
}

function createId() {
  return `book-${Date.now()}-${Math.random().toString(16).slice(2, 8)}`;
}

function formatThickness(book) {
  return Math.round(calculateBookThickness(book));
}

function findBook(id) {
  return state.books.find((book) => book.id === id) || null;
}

function readTheme() {
  try {
    return localStorage.getItem(THEME_KEY) === 'dark' ? 'dark' : 'light';
  } catch {
    return 'light';
  }
}

function applyTheme(theme) {
  state.theme = theme;
  document.body.setAttribute('data-theme', theme);
  elements.themeToggle.textContent = theme === 'light' ? 'Autumn Night' : 'Autumn Light';
}

function escapeHtml(value) {
  return String(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char]));
}

